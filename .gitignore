dist/
game/shots/
.uploads/

# Raw SWF rip: 59MB of intermediate SVG, sprites and sounds, produced by ffdec
# from original/the_farmer.swf — which is in here, so this is one command away
# from existing again. The game itself only needs game/public/assets, which
# tools/prep-assets.mjs derives from it.
#
# The working sheets the art generator made are NOT ignored, unlike this: they
# came out of a generation run rather than a decompiler, so nothing regenerates
# them and re-cutting the sprites at another size would need them back.
extracted/

# secrets and the machine this happens to be running on
.env.local
.env
tools/.venv/
run/
# Points the build at whatever tunnel is up right now; not a fact about the game.
game/.env.production
